# ─────────────────────────────────────────────────────────────────────────────
# Enterprise AI Red Team Platform — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# CORS (comma-separated origins, or * for all)
CORS_ORIGIN=http://localhost:5173

# ─── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED: Generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-chars
JWT_EXPIRES_IN=7d

# ─── SSO / OIDC (optional) ───────────────────────────────────────────────────
# "Sign in with SSO" via OpenID Connect (Okta, Azure AD/Entra, Google, Auth0,
# Keycloak, …). SSO activates only when the four required vars below are set.
# Register EART as an OIDC app in your IdP; set the redirect URI to
# <APP_URL>/api/auth/oidc/callback.
# OIDC_ISSUER=https://your-idp.example.com          # discovery base (no trailing slash)
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:15500/api/auth/oidc/callback
# OIDC_SCOPES=openid email profile
# OIDC_ALLOWED_DOMAINS=yourcompany.com              # comma-separated; empty = any verified email
# OIDC_DEFAULT_ROLE=viewer                          # role for auto-provisioned SSO users
# OIDC_REQUIRE_VERIFIED_EMAIL=true

# ─── Database ────────────────────────────────────────────────────────────────
# The driver is chosen from DATABASE_URL: a postgres:// or postgresql:// URL uses
# PostgreSQL (postgres-js); anything else is treated as a SQLite file path.
#
# SQLite (default, no setup needed):
DATABASE_URL=./data/eart.db

# PostgreSQL (optional, uncomment and fill in). Tables are created automatically
# on first boot / `npm run db:migrate`; no external migration step is required.
# DATABASE_URL=postgresql://eart:yourpassword@localhost:5432/eart

# ─── Redis (BullMQ) ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Reports ─────────────────────────────────────────────────────────────────
REPORT_DIR=./data/reports

# ─── Email (optional, for scan completion notifications) ─────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Set to "true" for port 465 (SSL); leave unset for STARTTLS on port 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@enterpriseairedteam.com

# Public URL used in email links (no trailing slash)
APP_URL=http://localhost:15500

# ─── Ollama (optional) ────────────────────────────────────────────────────────
# Override Ollama URL for Docker deployments. When unset, EART auto-detects
# Docker and rewrites localhost → host.docker.internal.
# OLLAMA_URL=http://host.docker.internal:11434

# Timeout in seconds for Ollama requests (default: 900 = 15 minutes).
# Increase for very slow models; decrease if you prefer faster failure.
# OLLAMA_TIMEOUT=900

# ─── AI grading / remediation (optional) ─────────────────────────────────────
# An independent AI provider is used to (a) generate remediation advice and
# (b) act as a semantic "judge" that re-checks attack responses the regex
# grader marked safe — catching models that comply in their own words instead
# of emitting the exact exploit marker. Configure a provider under
# Settings → AI Remediation, or set ANTHROPIC_API_KEY below as a fallback.
# The judge NEVER uses the target model to grade itself.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Set SCAN_JUDGE=off to disable the semantic judge and grade with regex only.
# SCAN_JUDGE=on
#
# Live-model smoke test (npm run smoke:live) — validates the real target-call +
# judge path against live models. Skips cleanly unless these are set:
# LIVE_SMOKE_TARGET_URL=https://api.openai.com
# LIVE_SMOKE_TARGET_TYPE=openai        # openai | ollama | anthropic
# LIVE_SMOKE_TARGET_MODEL=gpt-4o-mini
# LIVE_SMOKE_TARGET_KEY=               # target bearer key, if required
# (the judge uses ANTHROPIC_API_KEY / ANTHROPIC_MODEL above)
#
# The same independent provider drives DeepTeam's real engine (the LLM that
# simulates deepteam's attacks and evaluates responses). Without it, DeepTeam
# falls back to EART's labelled heuristic probes. Tune the real run with:
# DEEPTEAM_ATTACKS=PromptInjection,Roleplay   # attack enhancements to apply
# DEEPTEAM_ATTACKS_PER_TYPE=1                  # baseline attacks per vuln type
# DEEPTEAM_MAX_CONCURRENT=3                    # concurrent simulations
#
# The same provider drives PyRIT's real engine (adversarial orchestration +
# scoring). Without it, PyRIT falls back to EART's labelled heuristic probes.
# Tune the multi-turn attacks (Crescendo / TAP / PAIR):
# PYRIT_MAX_TURNS=4            # Crescendo max escalation turns
# PYRIT_TREE_WIDTH=2           # TAP/PAIR tree width
# PYRIT_TREE_DEPTH=2           # TAP/PAIR tree depth
# PYRIT_SCALE_THRESHOLD=0.7    # TAP/PAIR objective-achieved score threshold

# ─── Data governance / retention (optional) ──────────────────────────────────
# Delete scans (and their results, reports, and report files) older than this
# many days. 0 = keep forever (default). Runs daily and on-demand
# (POST /api/retention/purge, admin). In-flight scans are never purged.
# DATA_RETENTION_DAYS=0
# Delete audit-log rows older than this many days. 0 = keep forever.
# AUDIT_RETENTION_DAYS=0
# Response minimization: set to false so findings do NOT persist the raw
# prompt/response text (which can contain sensitive target data) — only the
# verdict + metadata are stored. Default true.
# SCAN_STORE_RESPONSES=true

# ─── Scan governance (cost, rate, authorization) ─────────────────────────────
# Hard ceiling on the estimated number of target-model calls per scan. A scan
# whose estimate exceeds this is refused at creation with the estimate. 0 =
# unlimited. GET /api/scans/estimate returns the estimate before running.
# SCAN_MAX_TARGET_CALLS=25000
#
# Rate-limit EART's own outbound calls to the target model, in calls/minute
# (0 = unlimited). Bounds the promptfoo/Ollama/custom attack loop; the Docker
# workers are bounded by their own prompt/turn caps.
# SCAN_TARGET_RATE_LIMIT=0
#
# Target authorization allow-list: comma-separated hosts or *.wildcard patterns.
# When set, only matching target hosts may be added to a project or scanned —
# prevents EART being pointed at a third party's endpoint. Unset = no
# restriction (SSRF denylist still applies).
# TARGET_ALLOWLIST=api.mycorp.com,*.internal.mycorp.com

# ─── Docker worker images ────────────────────────────────────────────────────
# These are the image names for Python tool runners
# Build with: docker compose --profile workers build
GARAK_IMAGE=eart-garak:latest
PYRIT_IMAGE=eart-pyrit:latest
DEEPTEAM_IMAGE=eart-deepteam:latest
